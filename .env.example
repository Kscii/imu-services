# Generate secrets with scripts/create_env.py. Never commit .env.
# Production deploy selects immutable ghcr.io/...@sha256:... references.
IMU_RUNTIME_IMAGE=localhost/imu-runtime:1.1.0
IMU_QUERY_IMAGE=localhost/imu-query:1.1.0
IMU_ADMIN_DB_PASSWORD=
IMU_RUNTIME_DB_PASSWORD=
IMU_QUERY_DB_PASSWORD=
IMU_WRITE_TOKEN=
IMU_READ_TOKEN=
IMU_WORKERS=2
IMU_THREADS=2
IMU_WORKER_CPUS=2
IMU_STEPS_ENABLED=true
IMU_API_PORT=8100
IMU_QUERY_PORT=8101
# Used by operations/backup.sh; destination must already be configured and trusted.
IMU_BACKUP_DESTINATION=

# Whole-record pool; sign adaptation is experimental and disabled by default.
IMU_WHOLE_WORKERS=1
IMU_WHOLE_MEMORY=8g
IMU_WHOLE_CPUS=2
IMU_SIGN_ADAPTATION=false
IMU_ADMIT_NEW_RUNS=true
IMU_MAX_WHOLE_RUNS=4
IMU_MAX_WHOLE_PENDING_BYTES=536870912

  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "batch_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Batch Id"
          },
          "start_sample": {
            "type": "integer",
            "maximum": 9007199254740992.0,
            "minimum": 0.0,
            "title": "Start Sample"
          },
          "sample_rate_hz": {
            "type": "integer",
            "title": "Sample Rate Hz",
            "default": 25
          },
          "acceleration_mps2": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "maxItems": 15000,
            "minItems": 1,
            "title": "Acceleration Mps2"
          },
          "angular_velocity_rads": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "title": "Angular Velocity Rads"
          },
          "valid": {
            "anyOf": [
              {
                "items": {
                  "type": "boolean"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid"
          },
          "excluded": {
            "anyOf": [
              {
                "items": {
                  "type": "boolean"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excluded"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "batch_id",
          "start_sample",
          "acceleration_mps2",
          "angular_velocity_rads"
        ],
        "title": "BatchRequest"
      },
      "CreateRun": {
        "properties": {
          "request_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Request Key"
          },
          "recording_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Recording Id"
          },
          "device_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Device Id"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Start Time"
          },
          "steps_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steps Enabled"
          },
          "mode": {
            "type": "string",
            "const": "incremental",
            "title": "Mode",
            "default": "incremental"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_key",
          "recording_id",
          "device_id",
          "start_time"
        ],
        "title": "CreateRun"
      },
      "GapRequest": {
        "properties": {
          "batch_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Batch Id"
          },
          "start_sample": {
            "type": "integer",
            "maximum": 9007199254740992.0,
            "minimum": 0.0,
            "title": "Start Sample"
          },
          "sample_count": {
            "type": "integer",
            "maximum": 15000.0,
            "minimum": 1.0,
            "title": "Sample Count"
          },
          "excluded": {
            "type": "boolean",
            "title": "Excluded",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "batch_id",
          "start_sample",
          "sample_count"
        ],
        "title": "GapRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SealRequest": {
        "properties": {
          "end_sample": {
            "type": "integer",
            "maximum": 9007199254740992.0,
            "minimum": 0.0,
            "title": "End Sample"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "end_sample"
        ],
        "title": "SealRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
